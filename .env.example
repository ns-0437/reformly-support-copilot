# --- Database ---
# In production, add ?connection_limit=<n> — under autoscaling, each Cloud
# Run instance opens its own Prisma pool against the same database, and the
# untuned default can collectively exceed the database's max connections
# well before traffic looks unusually high. PrismaService warns at boot if
# this is missing.
DATABASE_URL="postgresql://reformly:reformly@localhost:5432/reformly_support?schema=public"

# --- Redis / BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave both unset for local Docker Redis. Managed providers (Upstash,
# Memorystore, etc.) need a password and TLS on the standard port.
REDIS_PASSWORD=
REDIS_TLS=false

# --- LLM provider ---
# Leave ANTHROPIC_API_KEY unset to run in MOCK_LLM mode (deterministic fake
# responses) so the whole pipeline is reviewable without paid API access.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
MOCK_LLM=true

# --- Embeddings (RAG) ---
# Leave unset to use the deterministic local hash-embedding fallback.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
MOCK_EMBEDDINGS=true

# --- Reliability thresholds ---
# Below this combined confidence score, the response is routed to a human
# instead of being sent straight to the customer.
CONFIDENCE_ESCALATION_THRESHOLD=0.62
# Any tool call touching money/account state is escalated automatically
# regardless of confidence, unless explicitly whitelisted.
AUTO_ESCALATE_HIGH_RISK_TOOLS=true

# --- Simulated third-party API flakiness (Shopify/Stripe stand-ins) ---
PROVIDER_FAILURE_RATE=0.25
PROVIDER_TIMEOUT_RATE=0.1

# --- Error tracking ---
# Leave unset to run with Sentry fully disabled (no-op) locally/in CI.
SENTRY_DSN=

# --- Admin auth ---
# Required to access /escalations and /analytics — every request without a
# matching Basic Auth header is rejected. No default: unset means locked out
# entirely, not open.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Webhook signature verification ---
# Required to accept inbound /webhooks/shopify and /webhooks/stripe events —
# unset means every request is rejected, not accepted unverified. In a real
# integration these come from the Shopify/Stripe app dashboard; here they're
# whatever shared secret you configure when sending a test event.
SHOPIFY_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=

# --- CORS ---
# Comma-separated allowlist of browser origins allowed to call this API.
# Defaults to the local dashboard's dev origin only — add the deployed
# dashboard's URL in production (e.g. https://your-app.vercel.app).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- App ---
PORT=3001
NODE_ENV=development
