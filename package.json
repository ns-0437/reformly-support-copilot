{
  "name": "reformly-support-copilot",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "prisma:generate": "npm run prisma:generate --workspace=apps/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=apps/api",
    "seed": "npm run seed --workspace=apps/api",
    "test": "npm test --workspace=apps/api",
    "lint": "npm run lint --workspace=apps/api",
    "build": "npm run build --workspace=apps/api && npm run build --workspace=apps/web"
  }
}
